# Hugging Face read-only token. Optional for public models, but makes
# downloads more reliable and is required for gated/private repos.
HF_TOKEN=

# Which model profile `docker compose up` starts.
#   stock -> unsloth/Qwen3.6-27B-MTP-GGUF (UD-Q4_K_XL)
#   fable -> DavidAU Qwen3.6-27B-Fable-Fusion-711 (MTP Q4_K_M)
# Override per command with: docker compose --profile fable up -d
COMPOSE_PROFILES=stock
